  }

  /*
   * BGP-LS BGP-only fabric distribution. Per the same recipe as
   * advertise-all-vni at the global EVPN xpath, augment ONLY the
   * global xpath so the leaf isn't exposed under bmp-config /
   * neighbors / peer-groups (where it would be meaningless).
   */
  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/l2vpn-link-state" {
    leaf distribute-bgp-fabric-link-state {
      type boolean;
      description
        "Enable BGP-LS distribution for BGP-only fabrics. When set,
         bgpd originates BGP-LS Node/Link/Prefix NLRIs from the local
         BGP topology (draft-ietf-idr-bgp-ls-bgp-only-fabric).
         CLI: [no] distribute bgp-fabric-link-state at BGP_LS_NODE.
         Presence-leaf - explicit `no` must fire the destroy callback
         to withdraw the originated NLRIs.";
    }
  }

