// SPDX-License-Identifier: BSD-2-Clause
module frr-bgp {
  yang-version 1.1;
  namespace "http://frrouting.org/yang/bgp";
  prefix frr-bgp;

  import frr-routing {
    prefix frr-rt;
  }

  import ietf-inet-types {
    prefix inet;
  }

  import ietf-yang-types {
    prefix yang;
  }

  import frr-vrf {
    prefix frr-vrf;
  }

  import frr-interface {
    prefix frr-interface;
  }

  import frr-bgp-types {
    prefix frr-bt;
  }

  import frr-route-types {
    prefix frr-route-types;
  }

  import frr-route-map {
    prefix frr-route-map;
  }

  include "frr-bgp-common";

  include "frr-bgp-common-structure";

  include "frr-bgp-common-multiprotocol";

  include "frr-bgp-neighbor";

  include "frr-bgp-peer-group";

  include "frr-bgp-bmp";

  organization
    "FRRouting";
  contact
    "FRR Users List: <mailto:frog@lists.frrouting.org> FRR Development
     List: <mailto:dev@lists.frrouting.org>";
  description
    "This module defines a model for managing FRR bgpd daemon.

     Copyright 2020 FRRouting

     Redistribution and use in source and binary forms, with or without
     modification, are permitted provided that the following conditions
     are met:

     1. Redistributions of source code must retain the above copyright notice,
     this list of conditions and the following disclaimer.

     2. Redistributions in binary form must reproduce the above copyright
     notice, this list of conditions and the following disclaimer in the
     documentation and/or other materials provided with the distribution.

     THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
     \"AS IS\" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
     LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR
     A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT
     HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
     SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT
     LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
     DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
     THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
     (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
     OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.";

  revision 2019-12-03 {
    description
      "Initial revision.";
  }

  identity bgp {
    base frr-rt:routing-protocol;
    description
      "BGP protocol.";
  }

  grouping mp-afi-unicast-common {
    uses global-group-use-multiple-paths;

    uses global-redistribute;

    uses admin-distance;
  }

  /*
   * BGP daemon-wide settings (not per-instance).
   * These settings affect the bgp_master structure and apply to all BGP instances.
   */
  container daemon-settings {
    description
      "BGP daemon-wide configuration settings.";

    leaf no-rib {
      type boolean;
      default "false";
      description
        "Disable BGP route installation to RIB (Zebra).
         When enabled, BGP will not install routes into the kernel routing table.
         CLI: bgp no-rib";
    }

    leaf send-extra-data {
      type boolean;
      default "false";
      description
        "Send extra data to Zebra for display/use.
         CLI: bgp send-extra-data zebra";
    }

    leaf input-queue-limit {
      type uint32 {
        range "1..4294967295";
      }
      default "10000";
      description
        "BGP input message queue limit.
         CLI: bgp input-queue-limit (1-4294967295)";
    }

    leaf output-queue-limit {
      type uint32 {
        range "1..4294967295";
      }
      default "10000";
      description
        "BGP output message queue limit.
         CLI: bgp output-queue-limit (1-4294967295)";
    }

    leaf session-dscp {
      type uint8 {
        range "0..63";
      }
      default "48";
      description
        "DSCP value for BGP TCP sessions.
         CLI: bgp session-dscp (0-63)";
    }

    leaf ipv6-auto-ra {
      type boolean;
      default "false";
      description
        "Automatically send IPv6 Router Advertisement for BGP unnumbered.
         CLI: bgp ipv6-auto-ra";
    }

    list community-alias {
      key "community";
      description
        "Define an alias for a BGP community or large community.
         CLI: bgp community alias COMMUNITY ALIAS";

      leaf community {
        type string {
          length "1..64";
        }
        description
          "Community value in AA:BB format (standard community) or
           AA:BB:CC format (large community).";
      }

      leaf alias {
        type string {
          length "1..128";
        }
        mandatory true;
        description
          "Human-readable alias name for the community.";
      }
    }

    container debug {
      description
        "BGP debug configuration.";

      leaf updates {
        type boolean;
        default "false";
        description
          "Enable BGP updates debugging.";
      }

      leaf updates-out {
        type boolean;
        default "false";
        description
          "Enable BGP outbound updates debugging.";
      }

      leaf nht {
        type boolean;
        default "false";
        description
          "Enable BGP nexthop tracking debugging.";
      }

      leaf vpn-label {
        type boolean;
        default "false";
        description
          "Enable BGP VPN label debugging.";
      }

      leaf vpn-leak-from-vrf {
        type boolean;
        default "false";
        description
          "Enable BGP VPN leak-from-vrf debugging.";
      }
    }

    /*
     * Master-level (config-node) graceful-restart settings.
     *
     * These leaves capture commands typed at CONFIG_NODE (outside any
     * `router bgp ...` block), e.g. `bgp graceful-restart`. Such commands
     * apply to all BGP instances: existing ones get their state updated by
     * the modify callback, and new instances inherit at create time
     * (mirroring the legacy bm->flags propagation in baseline bgpd.c).
     *
     * No defaults — these are presence-leaves so an explicit user `no`
     * actually fires the modify callback (see
     * feedback_yang_default_swallows_modify.md).
     */
    container graceful-restart {
      description
        "BGP master-level graceful-restart defaults that propagate to all
         bgp instances.";

      leaf enabled {
        type boolean;
        description
          "Enable graceful-restart restarter mode at the bgpd master level.
           CLI: [no] bgp graceful-restart (typed at CONFIG_NODE).";
      }
    }

    leaf advertisement-delay {
      type uint16 {
        range "1..3600";
      }
      description
        "Hold route advertisements to peers for the configured number of
         seconds after the first peer reaches Established state. Master-
         level setting that propagates to all bgp instances. CLI: bgp
         advertisement-delay (1-3600) at CONFIG_NODE.";
    }

    container suppress-fib-pending {
      description
        "Master-level (config-node) suppress-fib-pending. Maps to
         bm_wait_for_fib_set() in baseline bgpd.c.";

      leaf enabled {
        type boolean;
        description
          "Wait for FIB install at the bgpd master level.
           CLI: [no] bgp suppress-fib-pending [(0-10000)$delay] at CONFIG_NODE.";
      }

      leaf delay {
        type uint16 {
          range "0..10000";
        }
        description
          "Advertisement delay in milliseconds after FIB installation.";
      }
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol" {
    container bgp {
      when "../frr-rt:type = 'frr-bgp:bgp'" {
        description
          "BGP protocol augmentation of ietf-routing module
           control-plane-protocol.";
      }
      presence "Enables configuration of BGP";
      description
        "Top-level configuration for the BGP router.";
      container global {
        description
          "Global configuration for the BGP router.";

        uses global-system-config;

        leaf local-as {
          type inet:as-number;
          mandatory true;
          description
            "Local autonomous system number of the router.  Uses
             the 32-bit as-number type from the model in RFC 6991.";
        }

        leaf is-view {
          type boolean;
          default "false";
          description
            "True if this BGP instance is a `view` (no VRF/FIB sync),
             false if it is a regular default or VRF instance. Only
             meaningful when the enclosing control-plane-protocol's
             vrf is not the default VRF - a view borrows the default
             VRF socket but keeps its RIB separate.";
        }

        uses frr-rt:router-id;

        container confederation {
          description
            "Configuration options specifying parameters when the
             local router is within an autonomous system which is
             part of a BGP confederation.";
          leaf identifier {
            type inet:as-number;
            description
              "Confederation identifier for the autonomous system.";
          }

          leaf identifier-pretty {
            type string {
              length "1..16";
            }
            description
              "Confederation identifier preserving user notation
               (asplain or asdot). The numeric value of `identifier`
               is the source of truth; this leaf carries the original
               user input so cli_show + bgp_confederation_id_set
               (idempotency-skip on same pretty) can preserve format
               across config reloads.";
          }

          leaf-list member-as {
            type inet:as-number;
            description
              "Remote autonomous systems that are to be treated
               as part of the local confederation.";
          }
        }

        uses med-config;

        uses route-reflector-config;

        uses route-selection-options;

        uses global-neighbor-config;

        container graceful-restart {
          description
            "Parameters relating the graceful restart mechanism for
             BGP.";
          uses graceful-restart-config;
        }

        uses global-update-group-config;

        uses global-config-timers;

        uses global-bgp-config;

        uses global-network-config;

        uses global-graceful-shutdown;

        uses global-bmp-config;

        uses global-vnc-config;

        container afi-safis {
          description
            "List of address-families associated with the BGP
             instance.";
          list afi-safi {
            key "afi-safi-name";
            description
              "AFI, SAFI configuration available for the
               neighbour or group.";
            uses mp-afi-safi-config;

            uses mp-all-afi-safi-list-contents;
          }
        }

        container segment-routing {
          description
            "Segment Routing configuration for BGP.";
          container srv6 {
            description
              "SRv6 configuration for BGP.";
            leaf enabled {
              type boolean;
              default "false";
              description
                "Enable SRv6 for BGP.";
            }

            leaf locator-name {
              type string;
              description
                "SRv6 locator name.";
            }

            leaf encap-behavior {
              type enumeration {
                enum h-encaps {
                  value 0;
                  description
                    "H.Encaps behavior.";
                }
                enum h-encaps-red {
                  value 1;
                  description
                    "H.Encaps.Red behavior.";
                }
              }
              default "h-encaps";
              description
                "SRv6 encapsulation behavior.";
            }

            leaf srv6-only {
              type boolean;
              /*
               * Default must match the C-side init in bgpd.c::bgp_srv6_init
               * (bgp->srv6_only = true). The bgpd backend runs in NB diff-mode:
               * mgmtd suppresses MODIFY callbacks when the YANG dnode value
               * matches the YANG default. With YANG default "false" but C init
               * true, an explicit `no srv6-only` line in config silently never
               * reaches bgpd, leaving srv6_only stuck at true.
               */
              default "true";
              description
                "Only allow SRv6 and disallow MPLS routes.";
            }
          }
        }

        container sid-vpn-export {
          description
            "Per-VRF SID allocation for VPN export.
             Leaves are mutually exclusive (enforced by CLI).";
          leaf sid-index {
            type uint32 {
              range "1..4294967295";
            }
            description
              "SID allocation index.";
          }
          leaf sid-auto {
            type boolean;
            description
              "Automatically allocate SID.";
          }
          leaf sid-value {
            type inet:ipv6-address;
            description
              "Explicit SID value (IPv6 address).";
          }
        }
      }

      container peer-groups {
        description
          "Configuration for BGP peer-groups.";
        uses bgp-peer-group-list;
      }

      container neighbors {
        description
          "Configuration for BGP neighbors.";
        list neighbor {
          key "remote-address";
          description
            "List of BGP neighbors configured on the local system,
             uniquely identified by remote IPv[46] address.";
          leaf remote-address {
            type inet:ip-address;
            description
              "The remote IP address of this entry's BGP peer.";
          }

          leaf local-interface {
            type frr-interface:interface-ref {
              require-instance false;
            }
            description
              "Neighbor's interface name.";
          }

          leaf local-port {
            type inet:port-number {
              range "0..65535";
            }
            description
              "Neighbor's BGP TCP port number.";
          }

          leaf peer-group {
            type leafref {
              path "../../../peer-groups/peer-group/peer-group-name";
            }
            description
              "The peer-group with which this neighbor is associated.";
          }

          container neighbor-remote-as {
            leaf remote-as-type {
              type frr-bt:as-type;
              description
                "Remote AS type. Not required when neighbor inherits from peer-group.";
            }

            leaf remote-as {
              when "../remote-as-type = 'as-specified'";
              type inet:as-number;
              description
                "The remote autonomous system number received in
                 the BGP OPEN message.";
              reference
                "RFC 4271";
            }
          }

          uses neighbor-parameters;

          uses structure-neighbor-group-capability-options;

          uses structure-neighbor-group-local-role;
        }

        list unnumbered-neighbor {
          key "interface";
          description
            "List of BGP neighbors configured on the local system,
             uniquely identified by interfaces.";
          leaf interface {
            type frr-interface:interface-ref {
              require-instance false;
            }
            description
              "The local interface of this entry's BGP peer.";
          }

          leaf v6only {
            type boolean;
            default "false";
            description
              "When set to 'true' it will create a neighbor with v6
               link local only.";
          }

          leaf peer-group {
            type leafref {
              path "../../../peer-groups/peer-group/peer-group-name";
            }
            description
              "The peer-group with which this neighbor is associated.";
          }

          uses neighbor-remote-as;

          uses neighbor-parameters;

          uses structure-neighbor-group-capability-options {
            refine "frr-bgp:capability-options/extended-nexthop-capability" {
              default "true";
            }
          }

          uses structure-neighbor-group-local-role;
        }
      }
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/ipv4-unicast" {
    list network-config {
      key "prefix";
      description
        "A list of network routes.";
      leaf prefix {
        type inet:ipv4-prefix;
        description
          "IPv4 destination prefix.";
      }

      leaf backdoor {
        type boolean;
        default "false";
        description
          "Specify a BGP backdoor route.";
      }

      uses mp-afi-safi-network-config;
    }

    list aggregate-route {
      key "prefix";
      description
        "A list of aggregated routes.";
      leaf prefix {
        type inet:ipv4-prefix;
        description
          "IPv4 destination prefix.";
      }

      uses mp-afi-safi-agg-route-config;
    }

    list admin-distance-route {
      key "prefix";
      description
        "A list of routes with a particular admin distance.";
      leaf prefix {
        type inet:ipv4-prefix;
        description
          "IPv4 destination prefix.";
      }

      uses distance-per-route-config;
    }

    uses route-flap-dampening;

    uses mp-afi-unicast-common;

    uses global-filter-config;

    uses global-afi-safi-vpn-config;

    container sid-vpn-export {
      description
        "Per-AFI SID allocation for VPN export.
         Leaves are mutually exclusive (enforced by CLI).";
      leaf sid-index {
        type uint32 {
          range "1..4294967295";
        }
        description
          "SID allocation index.";
      }
      leaf sid-auto {
        type boolean;
        description
          "Automatically allocate SID.";
      }
      leaf sid-value {
        type inet:ipv6-address;
        description
          "Explicit SID value (IPv6 address).";
      }
    }

    container sid-unicast-export {
      description
        "Per-AFI SRv6 unicast SID for encapsulation over default VRF.
         CLI: sid export <index|auto|explicit> [behavior dt46] [route-map]";
      leaf sid-index {
        type uint32 {
          range "1..1048575";
        }
        description
          "SID allocation index.";
      }
      leaf sid-auto {
        type boolean;
        description
          "Automatically allocate SID.";
      }
      leaf sid-explicit {
        type inet:ipv6-address;
        description
          "Explicitly assigned SID value.";
      }
      leaf behavior-dt46 {
        type boolean;
        default "false";
        description
          "Allocate a DT46 SID (instead of the default DT4/DT6).";
      }
      leaf route-map {
        type frr-route-map:route-map-ref;
        description
          "Route-map to filter unicast SRv6 announcements.";
      }
    }

    leaf table-map {
      type frr-route-map:route-map-ref;
      description
        "Route-map for filtering routes before installing to RIB.
         CLI: table-map ROUTE-MAP-NAME";
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/ipv6-unicast" {
    list network-config {
      key "prefix";
      description
        "A list of network routes.";
      leaf prefix {
        type inet:ipv6-prefix;
        description
          "IPv6 destination prefix.";
      }

      leaf backdoor {
        type boolean;
        default "false";
        description
          "Specify a BGP backdoor route.";
      }

      uses mp-afi-safi-network-config;
    }

    list aggregate-route {
      key "prefix";
      description
        "A list of aggregated routes.";
      leaf prefix {
        type inet:ipv6-prefix;
        description
          "IPv6 destination prefix.";
      }

      uses mp-afi-safi-agg-route-config;
    }

    list admin-distance-route {
      key "prefix";
      description
        "A list of routes with a particular admin distance.";
      leaf prefix {
        type inet:ipv6-prefix;
        description
          "IPv6 destination prefix.";
      }

      uses distance-per-route-config;
    }

    uses route-flap-dampening;

    uses mp-afi-unicast-common;

    uses global-filter-config;

    uses global-afi-safi-vpn-config;

    container sid-vpn-export {
      description
        "Per-AFI SID allocation for VPN export.
         Leaves are mutually exclusive (enforced by CLI).";
      leaf sid-index {
        type uint32 {
          range "1..4294967295";
        }
        description
          "SID allocation index.";
      }
      leaf sid-auto {
        type boolean;
        description
          "Automatically allocate SID.";
      }
      leaf sid-value {
        type inet:ipv6-address;
        description
          "Explicit SID value (IPv6 address).";
      }
    }

    container sid-unicast-export {
      description
        "Per-AFI SRv6 unicast SID for encapsulation over default VRF.
         CLI: sid export <index|auto|explicit> [behavior dt46] [route-map]";
      leaf sid-index {
        type uint32 {
          range "1..1048575";
        }
        description
          "SID allocation index.";
      }
      leaf sid-auto {
        type boolean;
        description
          "Automatically allocate SID.";
      }
      leaf sid-explicit {
        type inet:ipv6-address;
        description
          "Explicitly assigned SID value.";
      }
      leaf behavior-dt46 {
        type boolean;
        default "false";
        description
          "Allocate a DT46 SID (instead of the default DT4/DT6).";
      }
      leaf route-map {
        type frr-route-map:route-map-ref;
        description
          "Route-map to filter unicast SRv6 announcements.";
      }
    }

    leaf table-map {
      type frr-route-map:route-map-ref;
      description
        "Route-map for filtering routes before installing to RIB.
         CLI: table-map ROUTE-MAP-NAME";
    }

    leaf nexthop-prefer-global {
      type boolean;
      default "false";
      description
        "Prefer global IPv6 nexthop over link-local for received updates
         (per-AFI override of the link-local default). Default false.";
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/ipv4-labeled-unicast" {
    uses global-group-use-multiple-paths;

    uses route-flap-dampening;
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/ipv6-labeled-unicast" {
    uses global-group-use-multiple-paths;

    uses route-flap-dampening;

    leaf nexthop-prefer-global {
      type boolean;
      default "false";
      description
        "Prefer global IPv6 nexthop over link-local for received updates
         (per-AFI override of the link-local default). Default false.";
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/ipv4-multicast" {
    list network-config {
      key "prefix";
      description
        "A list of network routes.";
      leaf prefix {
        type frr-route-types:ipv4-multicast-group-prefix;
        description
          "IPv4 multicast destination prefix.";
      }

      leaf backdoor {
        type boolean;
        default "false";
        description
          "Specify a BGP backdoor route.";
      }

      uses mp-afi-safi-network-config;
    }

    list aggregate-route {
      key "prefix";
      description
        "A list of aggregated routes.";
      leaf prefix {
        type frr-route-types:ipv4-multicast-group-prefix;
        description
          "IPv4 multicast destination prefix.";
      }

      uses mp-afi-safi-agg-route-config;
    }

    list admin-distance-route {
      key "prefix";
      description
        "A list of routes with a particular admin distance.";
      leaf prefix {
        type frr-route-types:ipv4-multicast-group-prefix;
        description
          "IPv4 multicast destination prefix.";
      }

      uses distance-per-route-config;
    }

    uses admin-distance;

    uses route-flap-dampening;

    uses global-filter-config;

    leaf table-map {
      type frr-route-map:route-map-ref;
      description
        "Route-map for filtering routes before installing to RIB.
         CLI: table-map ROUTE-MAP-NAME";
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/ipv6-multicast" {
    list network-config {
      key "prefix";
      description
        "A list of network routes.";
      leaf prefix {
        type frr-route-types:ipv6-multicast-group-prefix;
        description
          "IPv6 multicast destination prefix.";
      }

      leaf backdoor {
        type boolean;
        default "false";
        description
          "Specify a BGP backdoor route.";
      }

      uses mp-afi-safi-network-config;
    }

    list aggregate-route {
      key "prefix";
      description
        "A list of aggregated routes.";
      leaf prefix {
        type frr-route-types:ipv6-multicast-group-prefix;
        description
          "IPv6 multicast destination prefix.";
      }

      uses mp-afi-safi-agg-route-config;
    }

    list admin-distance-route {
      key "prefix";
      description
        "A list of routes with a particular admin distance.";
      leaf prefix {
        type frr-route-types:ipv6-multicast-group-prefix;
        description
          "IPv6 multicast destination prefix.";
      }

      uses distance-per-route-config;
    }

    uses route-flap-dampening;

    uses admin-distance;

    leaf table-map {
      type frr-route-map:route-map-ref;
      description
        "Route-map for filtering routes before installing to RIB.
         CLI: table-map ROUTE-MAP-NAME";
    }

    leaf nexthop-prefer-global {
      type boolean;
      default "false";
      description
        "Prefer global IPv6 nexthop over link-local for received updates
         (per-AFI override of the link-local default). Default false.";
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/ipv4-flowspec" {
    uses flow-spec-config;
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/l3vpn-ipv4-unicast" {
    uses global-afi-safi-vpn-network-config;

    leaf retain-route-target-all {
      type boolean;
      default "true";
      description
        "Retain all BGP updates for VPN routes regardless of route target match.
         Default is true, matching the C initialization that sets
         BGP_VPNVX_RETAIN_ROUTE_TARGET_ALL on BGP instance creation.";
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/l3vpn-ipv6-unicast" {
    uses global-afi-safi-vpn-network-config;

    leaf retain-route-target-all {
      type boolean;
      default "true";
      description
        "Retain all BGP updates for VPN routes regardless of route target match.
         Default is true, matching the C initialization that sets
         BGP_VPNVX_RETAIN_ROUTE_TARGET_ALL on BGP instance creation.";
    }
  }

  augment "/frr-rt:routing/frr-rt:control-plane-protocols/frr-rt:control-plane-protocol/bgp/global/afi-safis/afi-safi/l2vpn-evpn" {
    leaf advertise-all-vni {
      type boolean;
      default "false";
      description
        "Advertise all local VNIs.";
    }

    leaf advertise-svi-ip {
      type boolean;
      default "false";
      description
        "Advertise SVI (MAC-IP) routes for all VNIs.";
    }

    leaf advertise-default-gw {
      type boolean;
      default "false";
      description
        "Advertise the default gateway MAC-IP for all VNIs.";
    }

    leaf enable-resolve-overlay-index {
      type boolean;
      default "false";
      description
        "Enable resolution of overlay index gateway IP.";
    }

    leaf evpn-mh-startup-delay {
      type uint32 {
        range "0..3600";
      }
      units "seconds";
      description
        "Startup delay for EVPN multihoming in seconds.";
    }

    leaf disable-ead-evi-rx {
      type boolean;
      default "false";
      description
        "Disable processing of received EAD-EVI (Type-1 EVPN) routes.
         Default false matches C init bgp_mh_info->enable_ead_evi_rx = true.";
    }

    leaf disable-ead-evi-tx {
      type boolean;
      default "false";
      description
        "Disable generation of local EAD-EVI (Type-1 EVPN) routes.
         Default false matches C init bgp_mh_info->enable_ead_evi_tx = true.";
    }

    container advertise-ipv4-unicast {
      presence "Advertise IPv4 unicast as EVPN type-5 routes";
      description
        "Advertise IPv4 unicast routes as EVPN type-5.";
      leaf gateway-ip {
        type boolean;
        default "false";
        description
          "Use gateway IP overlay index.";
      }
      leaf route-map {
        type frr-route-map:route-map-ref;
        description
          "Route-map to filter type-5 advertisements.";
      }
    }

    container advertise-ipv6-unicast {
      presence "Advertise IPv6 unicast as EVPN type-5 routes";
      description
        "Advertise IPv6 unicast routes as EVPN type-5.";
      leaf gateway-ip {
        type boolean;
        default "false";
        description
          "Use gateway IP overlay index.";
      }
      leaf route-map {
        type frr-route-map:route-map-ref;
        description
          "Route-map to filter type-5 advertisements.";
      }
    }

    leaf vrf-rd {
      type string;
      description
        "Manually configured route distinguisher for VRF L3VNI.";
    }

    list vrf-route-target {
      key "rt-value direction";
      description
        "VRF route-target import/export configuration.";
      leaf rt-value {
        type string;
        description
          "Route target value (A.B.C.D:MN or EF:OPQR or GHJK:MN or *:MN).";
      }
      leaf direction {
        type enumeration {
          enum import {
            description
              "Import route target.";
          }
          enum export {
            description
              "Export route target.";
          }
        }
        description
          "Route target direction.";
      }
    }

    leaf vrf-route-target-import-auto {
      type boolean;
      default "false";
      description
        "Auto-derive import route targets for this VRF.";
    }

    leaf vrf-route-target-export-auto {
      type boolean;
      default "false";
      description
        "Auto-derive export route targets for this VRF.";
    }

    leaf macvrf-soo {
      type string;
      description
        "MAC-VRF Site-of-Origin extended community.";
    }

    leaf flooding {
      type enumeration {
        enum disable {
          description
            "Disable BUM flooding.";
        }
        enum head-end-replication {
          description
            "Use head-end replication for BUM flooding.";
        }
      }
      description
        "BUM packet flooding control.";
    }

    list vni {
      key "vni-number";
      description
        "EVPN VNI configuration.";
      leaf vni-number {
        type uint32 {
          range "1..16777215";
        }
        description
          "VNI number.";
      }
      leaf rd {
        type string;
        description
          "Manually configured route distinguisher for this VNI.";
      }
      leaf vni-flooding {
        type enumeration {
          enum disable {
            description
              "Disable BUM flooding for this VNI.";
          }
          enum head-end-replication {
            description
              "Use head-end replication for this VNI.";
          }
        }
        description
          "Per-VNI BUM flooding control.";
      }
      list route-target {
        key "rt-value direction";
        description
          "Per-VNI route-target import/export.";
        leaf rt-value {
          type string;
          description
            "Route target value.";
        }
        leaf direction {
          type enumeration {
            enum import {
              description
                "Import route target.";
            }
            enum export {
              description
                "Export route target.";
            }
          }
          description
            "Route target direction.";
        }
      }
      leaf advertise-default-gw {
        type boolean;
        default "false";
        description
          "Advertise default gateway for this VNI.";
      }
      leaf advertise-svi-ip {
        type boolean;
        default "false";
        description
          "Advertise SVI IP for this VNI.";
      }
    }
  }

