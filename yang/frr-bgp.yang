    uses structure-neighbor-route-reflector;

    uses structure-neighbor-route-server;

    uses structure-neighbor-group-soft-reconfiguration;

    uses structure-neighbor-group-filter-config;
  }

  /*
   * BGP Notifications
   */

  typedef bgp-fsm-state {
    type enumeration {
      enum idle {
        value 1;
        description "Idle state - no resources allocated";
      }
      enum connect {
        value 2;
        description "Connect state - waiting for TCP connection";
      }
      enum active {
        value 3;
        description "Active state - trying to connect";
      }
      enum opensent {
        value 4;
        description "OpenSent state - OPEN message sent";
      }
      enum openconfirm {
        value 5;
        description "OpenConfirm state - waiting for KEEPALIVE";
      }
      enum established {
        value 6;
        description "Established state - session up";
      }
      enum clearing {
        value 7;
        description "Clearing state - session being cleared";
      }
      enum deleted {
        value 8;
        description "Deleted state - peer being deleted";
      }
    }
    description "BGP FSM states";
  }

  typedef bgp-notification-error-code {
    type enumeration {
      enum message-header-error {
        value 1;
        description "Message Header Error";
      }
      enum open-message-error {
        value 2;
        description "OPEN Message Error";
      }
      enum update-message-error {
        value 3;
        description "UPDATE Message Error";
      }
      enum hold-timer-expired {
        value 4;
        description "Hold Timer Expired";
      }
      enum fsm-error {
        value 5;
        description "Finite State Machine Error";
      }
      enum cease {
        value 6;
        description "Cease";
      }
      enum route-refresh-error {
        value 7;
        description "ROUTE-REFRESH Message Error";
      }
      enum send-hold-timer-expired {
        value 8;
        description "Send Hold Timer Expired";
      }
    }
    description "BGP NOTIFICATION message error codes";
  }

  typedef bgp-cease-subcode {
    type enumeration {
      enum unspecific {
        value 0;
        description "Unspecified cease reason";
      }
      enum max-prefix-reached {
        value 1;
        description "Maximum Number of Prefixes Reached";
      }
      enum admin-shutdown {
        value 2;
        description "Administrative Shutdown";
      }
      enum peer-deconfigured {
        value 3;
        description "Peer De-configured";
      }
      enum admin-reset {
        value 4;
        description "Administrative Reset";
      }
      enum connection-rejected {
        value 5;
        description "Connection Rejected";
      }
      enum config-change {
        value 6;
        description "Other Configuration Change";
      }
      enum collision-resolution {
        value 7;
        description "Connection Collision Resolution";
      }
      enum out-of-resources {
        value 8;
        description "Out of Resources";
      }
      enum hard-reset {
        value 9;
        description "Hard Reset";
      }
      enum bfd-down {
        value 10;
        description "BFD Down";
      }
    }
    description "BGP NOTIFICATION Cease subcodes";
  }

  notification peer-state-change {
    description
      "This notification is sent when a BGP peer's FSM state changes.
       This is a superset notification that covers all state transitions.";

    leaf peer-address {
      type inet:ip-address;
      mandatory true;
      description "IP address of the BGP peer";
    }

    leaf vrf-name {
      type string;
      description "VRF name (default for the default VRF)";
    }

    leaf local-as {
      type inet:as-number;
      description "Local AS number";
    }

    leaf remote-as {
      type inet:as-number;
      description "Remote AS number";
    }

    leaf old-state {
      type bgp-fsm-state;
      mandatory true;
      description "Previous FSM state";
    }

    leaf new-state {
      type bgp-fsm-state;
      mandatory true;
      description "New FSM state";
    }
  }

  notification peer-established {
    description
      "This notification is sent when a BGP peer session
       transitions to the Established state.";

    leaf peer-address {
      type inet:ip-address;
      mandatory true;
      description "IP address of the BGP peer";
    }

    leaf vrf-name {
      type string;
      description "VRF name (default for the default VRF)";
    }

    leaf local-as {
      type inet:as-number;
      description "Local AS number";
    }

    leaf remote-as {
      type inet:as-number;
      description "Remote AS number";
    }

    leaf local-router-id {
      type inet:ipv4-address;
      description "Local router ID";
    }

    leaf remote-router-id {
      type inet:ipv4-address;
      description "Remote router ID";
    }
  }

  notification backward-transition {
    description
      "This notification is sent when a BGP peer leaves the
       Established state unexpectedly (backward transition).
       This is commonly known as a 'peer down' event.";

    leaf peer-address {
      type inet:ip-address;
      mandatory true;
      description "IP address of the BGP peer";
    }

    leaf vrf-name {
      type string;
      description "VRF name (default for the default VRF)";
    }

    leaf local-as {
      type inet:as-number;
      description "Local AS number";
    }

    leaf remote-as {
      type inet:as-number;
      description "Remote AS number";
    }

    leaf old-state {
      type bgp-fsm-state;
      description "Previous FSM state (typically Established)";
    }

    leaf new-state {
      type bgp-fsm-state;
      description "New FSM state";
    }

    leaf reason {
      type string;
      description "Human-readable reason for the backward transition";
    }

    leaf notification-error-code {
      type bgp-notification-error-code;
      description "NOTIFICATION error code if applicable";
    }

    leaf notification-error-subcode {
      type uint8;
      description "NOTIFICATION error subcode if applicable";
    }
  }

  notification notification-received {
    description
      "This notification is sent when a BGP NOTIFICATION message
       is received from a peer.";

    leaf peer-address {
      type inet:ip-address;
      mandatory true;
      description "IP address of the BGP peer";
    }

    leaf vrf-name {
      type string;
      description "VRF name (default for the default VRF)";
    }

    leaf error-code {
      type bgp-notification-error-code;
      mandatory true;
      description "NOTIFICATION error code";
    }

    leaf error-subcode {
      type uint8;
      mandatory true;
      description "NOTIFICATION error subcode";
    }

    leaf error-data {
      type binary;
      description "NOTIFICATION error data (if any)";
    }
  }

  notification notification-sent {
    description
      "This notification is sent when a BGP NOTIFICATION message
       is sent to a peer.";

    leaf peer-address {
      type inet:ip-address;
      mandatory true;
      description "IP address of the BGP peer";
    }

    leaf vrf-name {
      type string;
      description "VRF name (default for the default VRF)";
    }

    leaf error-code {
      type bgp-notification-error-code;
      mandatory true;
      description "NOTIFICATION error code";
    }

    leaf error-subcode {
      type uint8;
      mandatory true;
      description "NOTIFICATION error subcode";
    }

    leaf error-data {
      type binary;
      description "NOTIFICATION error data (if any)";
    }
  }

  notification prefix-limit-reached {
    description
      "This notification is sent when the number of prefixes
       received from a peer exceeds the configured limit.";

    leaf peer-address {
      type inet:ip-address;
      mandatory true;
      description "IP address of the BGP peer";
    }

    leaf vrf-name {
      type string;
      description "VRF name (default for the default VRF)";
    }

    leaf afi {
      type frr-bt:afi;
      mandatory true;
      description "Address Family Identifier";
    }

    leaf safi {
      type frr-bt:safi;
      mandatory true;
      description "Subsequent Address Family Identifier";
    }

    leaf prefix-limit {
      type uint32;
      mandatory true;
      description "Configured maximum prefix limit";
    }

    leaf prefix-count {
      type uint32;
      mandatory true;
      description "Current prefix count when limit was reached";
    }

    leaf action-taken {
      type enumeration {
        enum warning-only {
          description "Only logged a warning";
        }
        enum session-cleared {
          description "Session was cleared";
        }
        enum session-restart-scheduled {
          description "Session restart was scheduled";
        }
      }
      description "Action taken when limit was reached";
    }
  }

  /*
   * =========================================
   * BGP Operational State Data
   * Following frr-isisd pattern with separate top-level state container.
   * RESTCONF URL: GET /restconf/data/frr-bgp:bgpd
   * =========================================
   */
  container bgpd {
    config false;
    description
      "BGP operational state data. This container provides read-only
       access to BGP runtime state including neighbor sessions,
       route tables, and statistics.";

    list instance {
      key "vrf";
      description
        "BGP routing instance operational state.";

      leaf vrf {
        type frr-vrf:vrf-ref;
        description
          "VRF name (use 'default' for the default instance).";
      }

      leaf router-id {
        type inet:ipv4-address;
        description
          "BGP router identifier.";
      }

      leaf local-as {
        type inet:as-number;
        description
          "Local autonomous system number.";
      }

      leaf uptime {
        type yang:date-and-time;
        description
          "Timestamp when BGP instance started.";
      }

      leaf total-peers {
        type uint32;
        description
          "Total number of configured peers.";
      }

      leaf established-peers {
        type uint32;
        description
          "Number of peers in Established state.";
      }

      leaf total-prefixes {
        type uint32;
        description
          "Total number of prefixes in RIB across all AFI/SAFIs.";
      }

      container memory {
        description
          "BGP memory usage statistics.";

        leaf total-bytes {
          type uint64;
          description
            "Total memory used by BGP in bytes.";
        }

        leaf rib-count {
          type uint64;
          description
            "Number of RIB entries.";
        }

        leaf path-count {
          type uint64;
          description
            "Number of path entries.";
        }

        leaf attr-count {
          type uint64;
          description
            "Number of attribute entries.";
        }

        leaf community-count {
          type uint64;
          description
            "Number of community entries.";
        }

        leaf aspath-count {
          type uint64;
          description
            "Number of AS path entries.";
        }
      }

      container neighbors {
        description
          "BGP neighbor operational state.";

        list neighbor {
          key "remote-address";
          description
            "BGP neighbor session state.";

          leaf remote-address {
            type inet:ip-address;
            description
              "Neighbor IP address.";
          }

          leaf session-state {
            type enumeration {
              enum idle {
                description "Idle state - no resources allocated";
              }
              enum connect {
                description "Waiting for TCP connection to complete";
              }
              enum active {
                description "Attempting to initiate TCP connection";
              }
              enum opensent {
                description "OPEN message sent, waiting for response";
              }
              enum openconfirm {
                description "Received OPEN, waiting for KEEPALIVE";
              }
              enum established {
                description "BGP session established";
              }
              enum clearing {
                description "Session being cleared";
              }
              enum deleted {
                description "Session deleted";
              }
            }
            description
              "BGP FSM session state.";
          }

          leaf uptime {
            type string;
            description
              "Time since last state change (formatted string).";
          }

          leaf remote-as {
            type inet:as-number;
            description
              "Remote autonomous system number.";
          }

          leaf remote-router-id {
            type inet:ipv4-address;
            description
              "Remote BGP router identifier.";
          }

          leaf peer-type {
            type enumeration {
              enum ibgp {
                description "Internal BGP peer";
              }
              enum ebgp {
                description "External BGP peer";
              }
              enum confed-internal {
                description "Confederation internal peer";
              }
              enum confed-external {
                description "Confederation external peer";
              }
            }
            description
              "Type of BGP peering relationship.";
          }

          leaf last-reset-reason {
            type string;
            description
              "Reason for last session reset.";
          }

          leaf description {
            type string;
            description
              "Peer description configured by operator.";
          }

          leaf local-as {
            type inet:as-number;
            description
              "Local AS number used with this peer.";
          }

          leaf hostname {
            type string;
            description
              "Hostname advertised by peer via capability.";
          }

          leaf domainname {
            type string;
            description
              "Domain name advertised by peer via capability.";
          }

          leaf peer-group {
            type string;
            description
              "Peer group this neighbor belongs to.";
          }

          leaf interface {
            type string;
            description
              "Interface for unnumbered or directly connected peer.";
          }

          leaf tcp-mss {
            type uint32;
            description
              "TCP Maximum Segment Size for this peer.";
          }

          container timers {
            description
              "Negotiated BGP session timers.";

            leaf hold-time {
              type uint32;
              units "seconds";
              description
                "Negotiated hold time.";
            }

            leaf keepalive {
              type uint32;
              units "seconds";
              description
                "Negotiated keepalive interval.";
            }
          }

          container timestamps {
            description
              "Timestamps for peer events.";

            leaf last-read {
              type string;
              description
                "Time since last message read from peer.";
            }

            leaf last-write {
              type string;
              description
                "Time since last message written to peer.";
            }

            leaf last-update {
              type string;
              description
                "Time since last UPDATE message received.";
            }
          }

          container connection-stats {
            description
              "Connection establishment statistics.";

            leaf established-count {
              type uint32;
              description
                "Number of times BGP session established.";
            }

            leaf dropped-count {
              type uint32;
              description
                "Number of times BGP session dropped.";
            }
          }

          container queues {
            description
              "Message queue depths for this neighbor.";

            leaf input {
              type uint32;
              description
                "Number of messages in input queue (InQ).";
            }

            leaf output {
              type uint32;
              description
                "Number of messages in output queue (OutQ).";
            }
          }

          container message-statistics {
            description
              "BGP message counters.";

            container sent {
              description
                "Messages sent to peer.";

              leaf opens {
                type yang:counter64;
                description "OPEN messages sent.";
              }

              leaf notifications {
                type yang:counter64;
                description "NOTIFICATION messages sent.";
              }

              leaf updates {
                type yang:counter64;
                description "UPDATE messages sent.";
              }

              leaf keepalives {
                type yang:counter64;
                description "KEEPALIVE messages sent.";
              }

              leaf route-refresh {
                type yang:counter64;
                description "ROUTE-REFRESH messages sent.";
              }

              leaf total {
                type yang:counter64;
                description "Total messages sent.";
              }
            }

            container received {
              description
                "Messages received from peer.";

              leaf opens {
                type yang:counter64;
                description "OPEN messages received.";
              }

              leaf notifications {
                type yang:counter64;
                description "NOTIFICATION messages received.";
              }

              leaf updates {
                type yang:counter64;
                description "UPDATE messages received.";
              }

              leaf keepalives {
                type yang:counter64;
                description "KEEPALIVE messages received.";
              }

              leaf route-refresh {
                type yang:counter64;
                description "ROUTE-REFRESH messages received.";
              }

              leaf total {
                type yang:counter64;
                description "Total messages received.";
              }
            }
          }

          container prefix-statistics {
            description
              "Prefix counts per address family.";

            list afi-safi {
              key "afi-safi-name";
              description
                "Prefix statistics for a specific AFI/SAFI.";

              leaf afi-safi-name {
                type identityref {
                  base frr-rt:afi-safi-type;
                }
                description
                  "Address family identifier.";
              }

              leaf received {
                type uint32;
                description
                  "Number of prefixes received.";
              }

              leaf accepted {
                type uint32;
                description
                  "Number of prefixes accepted after filtering.";
              }

              leaf sent {
                type uint32;
                description
                  "Number of prefixes sent to peer.";
              }

              leaf table-version {
                type uint64;
                description
                  "Routing table version for this AFI/SAFI (TblVer).";
              }
            }
          }

          container capabilities {
            description
              "BGP capability exchange information.";

            leaf-list advertised {
              type string;
              description
                "Capabilities advertised to peer.";
            }

            leaf-list received {
              type string;
              description
                "Capabilities received from peer.";
            }

            leaf route-refresh {
              type boolean;
              description
                "Route refresh capability.";
            }

            leaf four-octet-as {
              type boolean;
              description
                "4-octet AS number capability.";
            }

            leaf graceful-restart {
              type boolean;
              description
                "Graceful restart capability.";
            }

            leaf add-path {
              type boolean;
              description
                "Add-path capability.";
            }

            leaf extended-nexthop {
              type boolean;
              description
                "Extended nexthop capability.";
            }
          }
        }
      }

      container update-groups {
        description
          "BGP update group information.";

        list update-group {
          key "id";
          description
            "Update group state.";

          leaf id {
            type uint64;
            description
              "Update group identifier.";
          }

          leaf afi-safi {
            type identityref {
              base frr-rt:afi-safi-type;
            }
            description
              "Address family for this update group.";
          }

          leaf member-count {
            type uint32;
            description
              "Number of peers in this update group.";
          }

          leaf update-count {
            type uint64;
            description
              "Number of updates generated.";
          }

          leaf packet-queue-length {
            type uint32;
            description
              "Current packet queue length.";
          }
        }
      }

      container dampening {
        description
          "Route dampening state.";

        leaf enabled {
          type boolean;
          description
            "Whether route dampening is enabled.";
        }

        leaf half-life {
          type uint16;
          units "seconds";
          description
            "Half-life time for penalty decay.";
        }

        leaf reuse-limit {
          type uint16;
          description
            "Penalty reuse threshold.";
        }

        leaf suppress-limit {
          type uint16;
          description
            "Penalty suppress threshold.";
        }

        leaf max-suppress-time {
          type uint16;
          units "seconds";
          description
            "Maximum suppress time.";
        }

        leaf dampened-paths {
          type uint32;
          description
            "Number of paths currently dampened.";
        }

        leaf history-paths {
          type uint32;
          description
            "Number of paths in history.";
        }
      }

      container srv6 {
        description
          "BGP SRv6 operational state.";

        leaf enabled {
          type boolean;
          description
            "Whether SRv6 is enabled for this BGP instance.";
        }

        leaf locator-name {
          type string;
          description
            "Name of the SRv6 locator in use.";
        }

        list sid {
          key "value";
          description
            "List of SRv6 SIDs allocated by BGP.";

          leaf value {
            type inet:ipv6-address;
            description
              "SRv6 SID value.";
          }

          leaf function-type {
            type enumeration {
              enum end-dt4 {
                description "End.DT4 - Decapsulation and IPv4 table lookup";
              }
              enum end-dt6 {
                description "End.DT6 - Decapsulation and IPv6 table lookup";
              }
              enum end-dt46 {
                description "End.DT46 - Decapsulation and IP table lookup";
              }
            }
            description
              "SRv6 function type.";
          }

          leaf vrf {
            type frr-vrf:vrf-ref;
            description
              "VRF associated with this SID.";
          }
        }
      }

      /*
       * BGP Routes/RIB operational data
       * Provides access to BGP routing table entries per AFI/SAFI.
       */
      container routes {
        description
          "BGP routing information base (RIB) entries.";

        list afi-safi {
          key "afi-safi-name";
          description
            "Routes for a specific AFI/SAFI combination.";

          leaf afi-safi-name {
            type identityref {
              base frr-rt:afi-safi-type;
            }
            description
              "Address family identifier.";
          }

          leaf table-version {
            type uint64;
            description
              "Current routing table version.";
          }

          leaf route-count {
            type uint32;
            description
              "Number of routes in this AFI/SAFI table.";
          }

          list route {
            key "prefix";
            description
              "A route entry in the BGP RIB.";

            leaf prefix {
              type string;
              description
                "Network prefix (e.g., '10.0.0.0/8' or '2001:db8::/32').";
            }

            list path {
              key "path-id";
              description
                "A path to the destination prefix. Multiple paths may exist
                 due to multipath or add-path.";

              leaf path-id {
                type uint32;
                description
                  "Path identifier. 0 for best path, >0 for add-path.";
              }

              leaf nexthop {
                type string;
                description
                  "Next hop address for this path.";
              }

              leaf metric {
                type uint32;
                description
                  "Multi-Exit Discriminator (MED) value.";
              }

              leaf local-preference {
                type uint32;
                description
                  "Local preference value.";
              }

              leaf weight {
                type uint32;
                description
                  "BGP weight for path selection.";
              }

              leaf origin {
                type enumeration {
                  enum igp {
                    description "Originated in IGP.";
                  }
                  enum egp {
                    description "Originated in EGP.";
                  }
                  enum incomplete {
                    description "Origin incomplete.";
                  }
                }
                description
                  "BGP origin attribute.";
              }

              leaf as-path {
                type string;
                description
                  "AS path attribute as a string.";
              }

              leaf communities {
                type string;
                description
                  "Standard communities as space-separated string.";
              }

              leaf extended-communities {
                type string;
                description
                  "Extended communities as space-separated string.";
              }

              leaf large-communities {
                type string;
                description
                  "Large communities as space-separated string.";
              }

              leaf source-peer {
                type string;
                description
                  "IP address of peer from which route was learned.";
              }

              leaf valid {
                type boolean;
                description
                  "Whether path is valid.";
              }

              leaf best {
                type boolean;
                description
                  "Whether this is the best path (selected for forwarding).";
              }

              leaf stale {
                type boolean;
                description
                  "Whether path is stale (graceful restart).";
              }

              leaf multipath {
                type boolean;
                description
                  "Whether path is part of ECMP multipath set.";
              }

              leaf uptime {
                type string;
                description
                  "Time since this path was received.";
              }

              leaf route-distinguisher {
                type string;
                description
                  "Route distinguisher for VPN routes (format: AS:value or IP:value).
                   Only present for MPLS VPN, ENCAP, and EVPN SAFIs.";
              }

              leaf-list mpls-labels {
                type uint32;
                description
                  "MPLS label stack for this path. First label is primary VPN label.
                   Present for labeled-unicast, MPLS VPN, and EVPN routes.";
              }

              leaf underlay-nexthop {
                type string;
                description
                  "Underlay network nexthop (tunnel endpoint) for VPN routes.
                   Differs from BGP nexthop in tunneled scenarios.";
              }

              leaf route-type {
                type string;
                description
                  "Route type string (e.g., 'bgp', 'static', 'connected').";
              }

              leaf route-subtype {
                type enumeration {
                  enum normal {
                    value 0;
                    description "Normal BGP route";
                  }
                  enum static {
                    value 1;
                    description "Static route";
                  }
                  enum aggregate {
                    value 2;
                    description "Aggregate route";
                  }
                  enum redistribute {
                    value 3;
                    description "Redistributed route";
                  }
                  enum imported {
                    value 5;
                    description "Imported from another BGP instance/SAFI";
                  }
                }
                description
                  "BGP route subtype classification.";
              }

              leaf srv6-sid {
                type string;
                description
                  "SRv6 Segment ID for SRv6-based VPN routes (IPv6 address format).";
              }

              leaf srv6-sid-structure {
                type string;
                description
                  "SRv6 SID structure as [block,node,func,arg] lengths.";
              }
            }
          }
        }
      }
    }
  }

  /*
   * BGP Clear RPCs
   * These provide RESTCONF-accessible clear operations equivalent to
   * the VTY "clear bgp" commands.
   */

  rpc clear-bgp-peer {
    description
      "Clear BGP peer sessions. Equivalent to VTY 'clear bgp' command.";
    input {
      leaf vrf {
        type string;
        default "default";
        description
          "VRF name. Use 'default' for the default VRF.";
      }

      choice target {
        description
          "Specify which peer(s) to clear.";
        case all-peers {
          leaf all {
            type empty;
            description
              "Clear all BGP peers.";
          }
        }
        case by-peer {
          leaf peer-address {
            type inet:ip-address;
            description
              "Clear specific peer by IP address.";
          }
        }
        case by-peer-group {
          leaf peer-group-name {
            type string;
            description
              "Clear all peers in the specified peer group.";
          }
        }
        case by-as {
          leaf as-number {
            type inet:as-number;
            description
              "Clear all peers with the specified AS number.";
          }
        }
        case external-peers {
          leaf external {
            type empty;
            description
              "Clear all external BGP peers.";
          }
        }
      }

      leaf afi {
        type enumeration {
          enum ipv4 {
            description "IPv4 address family.";
          }
          enum ipv6 {
            description "IPv6 address family.";
          }
          enum l2vpn {
            description "L2VPN address family.";
          }
        }
        description
          "Address family identifier. If not specified, applies to all AFIs.";
      }

      leaf safi {
        type enumeration {
          enum unicast {
            description "Unicast SAFI.";
          }
          enum multicast {
            description "Multicast SAFI.";
          }
          enum labeled-unicast {
            description "Labeled unicast SAFI.";
          }
          enum vpn {
            description "VPN SAFI.";
          }
          enum evpn {
            description "EVPN SAFI.";
          }
          enum flowspec {
            description "Flowspec SAFI.";
          }
        }
        description
          "Subsequent address family identifier. If not specified, applies to all SAFIs.";
      }

      leaf clear-type {
        type enumeration {
          enum hard {
            description "Hard reset - tear down and rebuild session.";
          }
          enum soft-in {
            description "Soft clear inbound - re-process received routes.";
          }
          enum soft-out {
            description "Soft clear outbound - re-advertise routes.";
          }
          enum soft-both {
            description "Soft clear both directions.";
          }
          enum message-stats {
            description "Clear message statistics only.";
          }
        }
        default "hard";
        description
          "Type of clear operation to perform.";
      }
    }

    output {
      leaf result {
        type string;
        description
          "Result message from the clear operation.";
      }
    }
  }

  rpc clear-bgp-prefix {
    description
      "Clear BGP bestpath for a specific prefix. Equivalent to VTY
       'clear bgp prefix' command.";
    input {
      leaf vrf {
        type string;
        default "default";
        description
          "VRF name. Use 'default' for the default VRF.";
      }

      leaf prefix {
        type inet:ip-prefix;
        mandatory true;
        description
          "IP prefix to clear (e.g., 10.0.0.0/8 or 2001:db8::/32).";
      }

      leaf afi {
        type enumeration {
          enum ipv4 {
            description "IPv4 address family.";
          }
          enum ipv6 {
            description "IPv6 address family.";
          }
        }
        description
          "Address family identifier. Derived from prefix if not specified.";
      }

      leaf safi {
        type enumeration {
          enum unicast {
            description "Unicast SAFI.";
          }
          enum multicast {
            description "Multicast SAFI.";
          }
        }
        default "unicast";
        description
          "Subsequent address family identifier.";
      }
    }

    output {
      leaf result {
        type string;
        description
          "Result message from the clear operation.";
      }
    }
  }

  rpc get-routes {
    description
      "Query BGP routes with filtering options. Returns routes matching
       all specified criteria. Use this RPC for flexible route queries
       instead of iterating the full routes container.";

    input {
      leaf vrf {
        type string;
        default "default";
        description
          "VRF name to query. Use 'default' for the default VRF.";
      }

      leaf afi-safi {
        type identityref {
          base frr-rt:afi-safi-type;
        }
        mandatory true;
        description
          "Address family to query (e.g., frr-routing:ipv4-unicast).";
      }

      leaf limit {
        type uint32;
        default 0;
        description
          "Maximum number of routes to return. 0 means unlimited.";
      }

      leaf prefix {
        type string;
        description
          "Prefix filter. Supports exact match (10.0.0.0/24) or
           pattern with wildcard (10.0.*).";
      }

      leaf prefix-len-min {
        type uint8 {
          range "0..128";
        }
        description
          "Minimum prefix length to match.";
      }

      leaf prefix-len-max {
        type uint8 {
          range "0..128";
        }
        description
          "Maximum prefix length to match.";
      }

      leaf nexthop {
        type inet:ip-address;
        description
          "Filter routes by nexthop address.";
      }

      leaf community {
        type string;
        description
          "Filter routes containing this community (e.g., 64512:100).";
      }

      leaf origin {
        type enumeration {
          enum igp {
            description "IGP origin.";
          }
          enum egp {
            description "EGP origin.";
          }
          enum incomplete {
            description "Incomplete origin.";
          }
        }
        description
          "Filter routes by origin type.";
      }

      leaf best-only {
        type boolean;
        default false;
        description
          "Only return best paths.";
      }
    }

    output {
      leaf route-count {
        type uint32;
        description
          "Number of routes returned.";
      }

      list routes {
        description
          "List of matching routes.";

        leaf prefix {
          type string;
          description
            "Route prefix.";
        }

        list paths {
          description
            "Paths for this route.";

          leaf path-id {
            type uint32;
            description
              "Path identifier.";
          }

          leaf nexthop {
            type inet:ip-address;
            description
              "Next hop address.";
          }

          leaf metric {
            type uint32;
            description
              "MED value.";
          }

          leaf local-preference {
            type uint32;
            description
              "Local preference.";
          }

          leaf weight {
            type uint32;
            description
              "Weight.";
          }

          leaf origin {
            type enumeration {
              enum igp {
                description "IGP origin.";
              }
              enum egp {
                description "EGP origin.";
              }
              enum incomplete {
                description "Incomplete origin.";
              }
            }
            description
              "Origin type.";
          }

          leaf as-path {
            type string;
            description
              "AS path.";
          }

          leaf communities {
            type string;
            description
              "Standard communities.";
          }

          leaf extended-communities {
            type string;
            description
              "Extended communities.";
          }

          leaf large-communities {
            type string;
            description
              "Large communities.";
          }

          leaf valid {
            type boolean;
            description
              "Route is valid.";
          }

          leaf best {
            type boolean;
            description
              "This is the best path.";
          }

          leaf stale {
            type boolean;
            description
              "Route is stale.";
          }

          leaf multipath {
            type boolean;
            description
              "Path is selected for multipath.";
          }

          leaf route-type {
            type string;
            description
              "Route type (bgp, static, connected).";
          }

          leaf route-subtype {
            type string;
            description
              "Route subtype (normal, static, aggregate, redistribute, imported).";
          }

          leaf source-peer {
            type string;
            description
              "Source peer address.";
          }

          leaf peer-id {
            type string;
            description
              "Peer router ID.";
          }

          leaf route-distinguisher {
            type string;
            description
              "Route Distinguisher for VPN routes.";
          }

          leaf mpls-labels {
            type string;
            description
              "MPLS labels (comma-separated list).";
          }

          leaf underlay-nexthop {
            type string;
            description
              "Underlay nexthop for VPN routes.";
          }

          leaf uptime {
            type string;
            description
              "Time since route learned.";
          }
        }
      }
    }
  }

  augment "/frr-interface:lib/frr-interface:interface" {
    description
      "Augments interface model with BGP MPLS forwarding.";

    leaf mpls-bgp-forwarding {
      type boolean;
      default "false";
      description
        "Enable MPLS forwarding for eBGP directly connected peers.";
    }

    leaf mpls-l3vpn-multi-domain-switching {
      type boolean;
      default "false";
      description
        "Bind a local MPLS label to incoming L3VPN updates on this interface.";
    }
  }

  grouping global-vnc-config {
    description
      "Virtual Network Control (VNC/RFAPI) configuration.";

    container vnc {
      presence "VNC/RFAPI is configured";
      description
        "VNC/RFAPI configuration for this BGP instance.";

      container rfp {
        description
          "RFP (Registered Forwarder Protocol) settings.";

        leaf holddown-factor {
          type uint32;
          description
            "RFP holddown factor.";
        }

        leaf full-table-download {
          type enumeration {
            enum on {
              value 1;
              description
                "Enable full table download.";
            }
            enum off {
              value 0;
              description
                "Disable full table download (partial).";
            }
          }
          description
            "RFP full table download mode.";
        }
      }

      container defaults {
        presence "VNC defaults are configured";
        description
          "VNC default settings for NVE groups.";

        leaf rd {
          type string;
          description
            "Default route distinguisher (e.g. ASN:NN or auto:vn:NN).";
        }

        leaf response-lifetime {
          type string;
          description
            "Default response lifetime in seconds, or 'infinite'.";
        }

        leaf rt-import {
          type string;
          description
            "Space-separated list of import route targets.";
        }

        leaf rt-export {
          type string;
          description
            "Space-separated list of export route targets.";
        }
      }

      list nve-group {
        key "name";
        description
          "VNC NVE (Network Virtualization Edge) group.";

        leaf name {
          type string;
          description
            "NVE group name.";
        }

        leaf prefix-vn {
          type string;
          description
            "VN (Virtual Network) address prefix.";
        }

        leaf prefix-un {
          type string;
          description
            "UN (Underlay Network) address prefix.";
        }

        leaf rd {
          type string;
          description
            "Route distinguisher for this NVE group.";
        }

        leaf response-lifetime {
          type string;
          description
            "Response lifetime in seconds, or 'infinite'.";
        }

        leaf rt-import {
          type string;
          description
            "Space-separated list of import route targets.";
        }

        leaf rt-export {
          type string;
          description
            "Space-separated list of export route targets.";
        }
      }

      list vrf-policy {
        key "name";
        description
          "VNC VRF policy group.";

        leaf name {
          type string;
          description
            "VRF policy name.";
        }

        leaf label {
          type uint32;
          description
            "MPLS label for this VRF policy.";
        }

        leaf rd {
          type string;
          description
            "Route distinguisher for this VRF policy.";
        }

        leaf rt-import {
          type string;
          description
            "Space-separated list of import route targets.";
        }

        leaf rt-export {
          type string;
          description
            "Space-separated list of export route targets.";
        }

        leaf nexthop {
          type string;
          description
            "Next-hop address (IPv4, IPv6, or 'self').";
        }
      }

      container export {
        description
          "VNC export configuration.";

        container bgp {
          description
            "VNC export to BGP configuration.";

          leaf mode {
            type enumeration {
              enum none {
                value 0;
                description
                  "No VNC-to-BGP export.";
              }
              enum group-nve {
                value 1;
                description
                  "Export using NVE group configuration.";
              }
              enum registering-nve {
                value 2;
                description
                  "Export based on registering NVE.";
              }
              enum ce {
                value 3;
                description
                  "Export based on CE.";
              }
            }
            description
              "VNC export to BGP mode.";
          }

          leaf-list group-nve-group {
            type string;
            description
              "NVE group names for group-nve export mode.";
          }
        }
      }

      container redistribute {
        description
          "VNC redistribute configuration.";

        leaf mode {
          type enumeration {
            enum plain {
              value 0;
              description
                "Plain redistribution mode.";
            }
            enum nve-group {
              value 1;
              description
                "Redistribute via NVE group.";
            }
            enum resolve-nve {
              value 2;
              description
                "Resolve NVE redistribution mode.";
            }
          }
          description
            "VNC redistribute mode.";
        }

        leaf-list ipv4-source {
          type string;
          description
            "IPv4 redistribution sources (e.g. bgp-direct).";
        }

        leaf-list ipv6-source {
          type string;
          description
            "IPv6 redistribution sources.";
        }
      }
    }
  }
}
